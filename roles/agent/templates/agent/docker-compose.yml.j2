# ==============================================================================
# NetBird overlay agent (mesh join)
# Managed by Ansible - do not edit on the target host.
# ==============================================================================
services:
  netbird:
    image: "{{ netbird_agent_image }}:{{ netbird_agent_version }}"
    container_name: netbird
    restart: unless-stopped
    stop_grace_period: 15s
    network_mode: host
    cap_add:
      - NET_ADMIN
      - SYS_ADMIN
      - SYS_RESOURCE
    devices:
      - /dev/net/tun
    environment:
      NB_SETUP_KEY: "{{ netbird_peer_setup_key }}"
{% if (netbird_management_url | default('', true) | string | trim) | length > 0 %}
      NB_MANAGEMENT_URL: "{{ netbird_management_url }}"
{% endif %}
      NB_HOSTNAME: "{{ inventory_hostname }}"
    volumes:
      - netbird_config:/var/lib/netbird
      # The agent's DNS manager talks to the host's systemd-resolved over D-Bus:
      # it serves the netbird zone (`<peer>.netbird.selfhosted`) on the host and
      # inside containers that forward to the host stub (e.g. the Panel's
      # Prometheus). Always mounted — DNS management is not optional.
      # File-mode DNS (hosts without systemd-resolved): the agent rewrites
      # /etc/resolv.conf to point at its embedded resolver, so the HOST file has
      # to be mounted — without this the agent only rewrites the container's
      # private copy and the host never resolves the netbird zone. With
      # systemd-resolved present the agent uses D-Bus and the mount is inert.
      - /etc/resolv.conf:/etc/resolv.conf

volumes:
  netbird_config:
    name: netbird_config
