# ==============================================================================
# NetBird overlay agent (mesh join)
# Managed by Ansible - do not edit on the target host.
# ==============================================================================
services:
  netbird:
    image: "{{ netbird_agent_image }}:{{ netbird_agent_version }}"
    container_name: netbird
    restart: unless-stopped
    stop_grace_period: 15s
    network_mode: host
    cap_add:
      - NET_ADMIN
      - SYS_ADMIN
      - SYS_RESOURCE
    devices:
      - /dev/net/tun
    environment:
      NB_SETUP_KEY: "{{ netbird_peer_setup_key }}"
      NB_MANAGEMENT_URL: "{{ netbird_management_url }}"
      NB_HOSTNAME: "{{ inventory_hostname }}"
    volumes:
      - netbird_config:/var/lib/netbird
{% if netbird_dns_manage | default(true) | bool %}
      # The agent's DNS manager talks to the host's systemd-resolved over D-Bus:
      # without this mount the netbird zone is not resolvable on the host (nor
      # inside containers that forward to the host stub).
      - /var/run/dbus:/var/run/dbus
{% endif %}

volumes:
  netbird_config:
    name: netbird_config
