# ==============================================================================
# node_exporter overlay-wait drop-in (roles/monitoring) - MANAGED BY ANSIBLE.
# ==============================================================================
# node_exporter binds ONE address: the host's overlay address (see
# roles/monitoring/defaults/main.yml). That address is created by the NetBird
# agent container, which Docker restarts at boot — after systemd has already
# tried to start this unit. The packaged unit has no restart policy, so without
# this drop-in the first start fails with
#
#   level=error msg="listen tcp <overlay>:9100: bind: cannot assign requested address"
#
# and stays failed until an operator restarts it.
#
# ExecStartPre waits for the address (the overlay normally appears within
# seconds); Restart=on-failure keeps retrying when the boot takes longer. The
# retries are bounded: five attempts, then the unit fails loudly so the missing
# overlay is visible instead of silently absent from Prometheus.
# ==============================================================================
[Unit]
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
ExecStartPre=/bin/sh -c 'i=0; until ip -4 -o addr show | grep -q "{{ overlay_ip }}/"; do i=$((i+1)); [ "$i" -ge 45 ] && exit 1; sleep 2; done'
Restart=on-failure
RestartSec=15
