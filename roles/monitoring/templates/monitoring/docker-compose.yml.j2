# ==============================================================================
# Monitoring log shipper (Alloy) - the overlay agent is deployed by roles/agent.
# Managed by Ansible - do not edit on the target host.
# ==============================================================================
services:
  alloy:
    image: "{{ alloy_image }}:{{ alloy_version }}"
    container_name: alloy
    restart: unless-stopped
    user: "0:0"
{% if (overlay_ip | default('', true) | length) > 0 %}
    # Resolve a NetBird-name loki_push_url (`<peer>.netbird.selfhosted`) through
    # the agent's embedded DNS on this host's own overlay address. An IP-literal
    # loki_push_url needs no resolver, so both forms work; the name survives a
    # re-enrolled central peer, whose overlay address would go stale.
    dns:
      - "{{ overlay_ip }}"
{% endif %}
    command:
      - run
      - /etc/alloy/config.alloy
      - --server.http.listen-addr=0.0.0.0:12345
    volumes:
      - ./config.alloy:/etc/alloy/config.alloy:ro
      - /var/log/journal:/var/log/journal:ro
      - /run/log/journal:/run/log/journal:ro
      - /etc/machine-id:/etc/machine-id:ro
