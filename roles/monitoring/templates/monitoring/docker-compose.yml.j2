# ==============================================================================
# Monitoring log shipper (Alloy) - the overlay agent is deployed by roles/agent.
# Managed by Ansible - do not edit on the target host.
# ==============================================================================
services:
  alloy:
    image: "{{ alloy_image }}:{{ alloy_version }}"
    container_name: alloy
    restart: unless-stopped
    user: "0:0"
    # Host networking so the agent can scrape the host-bound exporters on the
    # overlay address; the write endpoints are an overlay IP or a NetBird peer
    # name, resolved through the agent's host resolver.
    network_mode: host
    command:
      - run
      - /etc/alloy/config.alloy
      - --server.http.listen-addr=0.0.0.0:12345
    volumes:
      - ./config.alloy:/etc/alloy/config.alloy:ro
      - /var/log/journal:/var/log/journal:ro
      - /run/log/journal:/run/log/journal:ro
      - /etc/machine-id:/etc/machine-id:ro
{% if alloy_verify_receiver_enabled | bool %}
  verify-receiver:
    image: "{{ alloy_verify_receiver_image }}:{{ alloy_verify_receiver_version }}"
    container_name: alloy-verify-receiver
    restart: unless-stopped
    network_mode: host
    volumes:
      - ./verify-receiver.conf:/etc/nginx/conf.d/default.conf:ro
{% endif %}
