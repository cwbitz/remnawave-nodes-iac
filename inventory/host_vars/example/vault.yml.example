# ==============================================================================
# Per-host secrets schema (inventory/host_vars/example/vault.yml.example)
# ==============================================================================
# Scaffold a real one with `make host-init HOST=<hostname>`, then edit it with
# `make vault-edit HOST=<hostname>`. The real vault.yml is gitignored and NEVER
# committed (even encrypted); the vault password file that decrypts it is created
# by `make vault-init` (path set in ansible.cfg).

# --- SSH connection identity -------------------------------------------------
# The ansible/admin/root aliases are wired in
# inventory/group_vars/remnanodes/main.yml. Each identity's control-node
# private key, plus an optional control-node path to its matching public key.
# `make host-bootstrap` probes [ansible, admin, root], uses the first that works,
# and authorizes each supplied public key for its account (empty is ignored; keys
# are never generated). Paths only, never raw key strings.
#
# A private-key-only identity is NOT key mode: the account still gets a password
# (host_bootstrap_password, else generated here) so an unauthorized key cannot
# lock you out. An identity becomes key-only once its public-key path is set.
vault_host_root_password: ""
vault_host_root_ssh_privkey_file: "~/.ssh/id_ed25519"
vault_host_root_ssh_pubkey_file: ""
# The optional human 'admin' operator account (created only when
# host_admin_enabled: true in main.yml); it always gets a password for console
# login and sudo, plus any configured public key.
vault_host_admin_user: "admin"
vault_host_admin_password: ""
vault_host_admin_ssh_privkey_file: ""
vault_host_admin_ssh_pubkey_file: ""
# The `ansible` service account host-bootstrap creates/repairs (name fixed); its
# public key switches the account to key auth instead of a generated password.
vault_host_ansible_password: ""
vault_host_ansible_ssh_privkey_file: "~/.ssh/id_ed25519_ansible"
vault_host_ansible_ssh_pubkey_file: ""

# --- NetBird overlay (roles/agent) -------------------------------------------
# This node's enrollment setup key; the management URL is non-secret and lives in
# main.yml. The key decides which NetBird group the peer auto-joins, hence what
# the central observability stack discovers (`endpoint` grants no exit/LAN
# routes).
vault_netbird_setup_key: ""

# --- Remnawave Node (roles/remnanode) ----------------------------------------
# The Node's SECRET_KEY, copied from the docker-compose.yml the Panel generates
# when the Node is created. It is a live credential: the Panel authenticates the
# Node with it. (NODE_PORT is non-secret; set it in main.yml.)
vault_remnanode_secret_key: ""

# ==============================================================================
# Control-generated secrets (written here when left empty)
# ==============================================================================
#   vault_host_ansible_password  service-account password (only when no public
#                                key is given)
#   vault_host_admin_password    admin password (only when host_admin_enabled)
# Existing non-empty values are preserved (never rotated).
# ==============================================================================
